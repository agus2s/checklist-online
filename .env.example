# Supabase (Postgres) — gunakan Transaction pooler agar kompatibel IPv4 & serverless
# Format: postgresql://<user>.<project-ref>:<password-url-encoded>@<region>.pooler.supabase.com:6543/postgres
# URL-encode password bila ada karakter khusus (contoh # = %23, $ = %24).
SUPABASE_DATABASE_URL=postgresql://postgres.vzrsnwhtmzvaobwcqfgq:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres